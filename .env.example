# Copy to .env and fill in. Never commit .env.
# Document every variable the project needs here.

# Convex (production phase). `npx convex dev` writes these to apps/web/.env.local, which is not committed.
# Which Convex deployment the local tools talk to:
CONVEX_DEPLOYMENT=
# Address of the Convex database, used by the pages (public, not a secret):
NEXT_PUBLIC_CONVEX_URL=
# Address of the Convex HTTP routes (sign-in), public as well:
NEXT_PUBLIC_CONVEX_SITE_URL=

# Settings kept ON THE CONVEX DEPLOYMENT (Convex dashboard -> Settings -> Environment Variables), never in a file:
#   JWT_PRIVATE_KEY, JWKS   signing keys for sign-in sessions (generated once per deployment)
#   SITE_URL                address of the site (http://localhost:3000 in development)
#   AUTH_RESEND_KEY         Resend API key that sends the 6-digit codes (new account, forgotten password) (secret)
#   AUTH_EMAIL_FROM         sender after the domain is verified in Resend, e.g. "Echipa FindMyUni <echipa@domeniul-vostru.ro>"
#   ADMIN_EMAILS            comma-separated emails of the administrators who approve reviews
#   TURNSTILE_SECRET_KEY    Cloudflare Turnstile secret that verifies the bot check of the review form (secret; the dev deployment uses Cloudflare's public test secret)
#   AUTH_DEV_LOG_LINKS      set to 1 ONLY on the dev deployment: the email codes go to the function log (`npx convex logs`) instead of email

# Local test account, created by Claude on the DEV database only (not a real person, no real email):
#   username test.elev01, email test.elev01@example.com, password proba.locala.findmyuni
#   username test.elev02, email test.elev02@example.com, same password (email not confirmed; the daily clean-up deletes it after 7 days)

# Cloudflare Turnstile site key for the review form (public, goes in apps/web/.env.local and in Vercel):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Backups (scripts/backup.mjs): optional, set only in your own terminal, never in a file:
#   BACKUP_PASSWORD   password that encrypts the backup (otherwise it is asked); keep it in a password manager
#   BACKUP_DIR        where backups go (default ~/FindMyUni-backups; must be outside the project)
